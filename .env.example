# Copy these values into your deployment environment. Do not commit a real .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
# Set to 31536000 only after confirming HTTPS works for the full domain.
DJANGO_SECURE_HSTS_SECONDS=0
# Set True only when a trusted reverse proxy supplies X-Forwarded-Proto.
DJANGO_BEHIND_PROXY=False
DJANGO_LOG_LEVEL=INFO
POSTGRES_DB=dating_backend
POSTGRES_USER=dating_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
